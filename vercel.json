{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/portal",
      "destination": "/portal/index.html"
    },
    {
      "source": "/portal/",
      "destination": "/portal/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "clients.skripti.fi"
        }
      ],
      "destination": "/portal"
    }
  ],
  "headers": [
    {
      "source": "/(.*).(js|css|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
